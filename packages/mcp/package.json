{
  "name": "component-code-mcp",
  "version": "0.1.0",
  "description": "An MCP App that shows a React component in the chat, beside the code that uses it, with every value a control.",
  "keywords": [
    "mcp",
    "mcp-app",
    "react",
    "component",
    "preview",
    "claude",
    "chatgpt"
  ],
  "license": "MIT",
  "author": "Fabio Azevedo (https://fabio.cv)",
  "homepage": "https://componentcode.fabio.cv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naso/component-code.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/naso/component-code/issues",
  "type": "module",
  "bin": {
    "component-code-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist/stdio.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && node scripts/build.js",
    "start": "node dist/stdio.js",
    "host": "vite --config vite.host.config.ts",
    "test": "node --test test/*.test.js",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "component-code": "workspace:*",
    "esbuild": "0.28.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sucrase": "3.35.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-singlefile": "2.3.4",
    "zod": "4.6.7"
  }
}
