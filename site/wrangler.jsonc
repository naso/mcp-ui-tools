{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-ui-tools",
  "compatibility_date": "2026-11-15",
  // The site is static files, which are free. Only the MCP endpoints run code.
  "main": "../tools/mcp-ui-tools/src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/component-code/mcp", "/orbit/mcp"],
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "routes": [{ "pattern": "mcp-ui-tools.fabio.cv", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
