{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-ui-tools",
  "compatibility_date": "2026-11-15",
  // The site is static files, which are free. Only the MCP endpoints and the
  // gallery's API run code.
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/component-code/mcp", "/orbit/mcp", "/api/*"],
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // The drawings saved from the wall on X: their images, and the list of them.
  // `wrangler deploy` makes both the first time.
  "r2_buckets": [
    { "binding": "DRAWINGS", "bucket_name": "mcp-ui-tools-drawings" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gallery",
      "migrations_dir": "./migrations",
    },
  ],
  // Six saves a minute from one address, and 1,200 reads: a gallery opened
  // is about 25, so only a script asking without end is held back.
  "ratelimits": [
    {
      "name": "SAVES",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 },
    },
    {
      "name": "READS",
      "namespace_id": "1002",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  // Each request and what the Worker logs, kept a few days and searchable in
  // the dashboard, under Workers & Pages → mcp-ui-tools → Logs.
  "observability": { "enabled": true },
  "routes": [{ "pattern": "mcp-ui-tools.fabio.cv", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
